# Copy to backend/.env and adjust. Every setting is in app/config.py (prefix DASHCAM_).
DASHCAM_DATABASE_URL=postgresql+psycopg://dashcam:dashcam@localhost:5432/dashcam
# Where videos, clips and annotated videos are stored. The API and the worker must point at the same folder.
DASHCAM_STORAGE_DIR=../data/storage
DASHCAM_WORK_DIR=../data/work
# The Python that has perception[run] (PyTorch + CUDA) installed. Empty = the worker's own Python.
# Windows example: C:\path\to\dashcam-safety-copilot\perception\.venv\Scripts\python.exe
DASHCAM_PERCEPTION_PYTHON=
# Fine-tuned model from ml/ (empty = perception's default, the stock COCO model)
DASHCAM_PERCEPTION_WEIGHTS=
# "0" = first GPU, "cpu" = force CPU, empty = auto
DASHCAM_PERCEPTION_DEVICE=
