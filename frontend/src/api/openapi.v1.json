        "summary": "Get Clip",
        "description": "The short clip around one event (about 5 s before to 5 s after).",
        "operationId": "get_clip_api_v1_events__event_id__clip_get",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
