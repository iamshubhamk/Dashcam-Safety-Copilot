    "/api/v1/hazards": {
      "get": {
        "tags": [
          "hazards"
        ],
        "summary": "List Hazards",
        "description": "Hazards inside the visible map area, most-seen first.",
        "operationId": "list_hazards_api_v1_hazards_get",
        "parameters": [
          {
            "name": "bbox",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "west,south,east,north",
              "examples": [
                "72.8,18.9,73.0,19.1"
              ],
              "title": "Bbox"
            },
            "description": "west,south,east,north"
          },
          {
            "name": "class",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
